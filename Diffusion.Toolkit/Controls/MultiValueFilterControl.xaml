<UserControl x:Class="Diffusion.Toolkit.Controls.MultiValueFilterControl"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:local="clr-namespace:Diffusion.Toolkit.Controls"
       xmlns:converters="clr-namespace:Diffusion.Toolkit.Converters"
       xmlns:fa="http://schemas.fontawesome.io/icons/"
       xmlns:lex="http://wpflocalizeextension.codeplex.com"
       lex:LocalizeDictionary.Provider="{StaticResource LocalizationProvider}"
       lex:LocalizeDictionary.Separation="."
       lex:LocalizeDictionary.DefaultProvider="{StaticResource LocalizationProvider}"
       mc:Ignorable="d"
       x:Name="Root"
       d:DesignHeight="120" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:InverseBoolToVisibilityCollapsedConverter x:Key="invBoolToVis"></converters:InverseBoolToVisibilityCollapsedConverter>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding OperatorOptions, ElementName=Root}"
                            Visibility="{Binding IsFirst, Converter={StaticResource invBoolToVis}}"
                            Grid.Column="0"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="20">
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding ComparisonOptions, ElementName=Root}"
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Value"
                            SelectedValue="{Binding Comparison, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="20">
                        </ComboBox>
                        <ComboBox IsEditable="True"
                            ItemsSource="{Binding ValueOptions, ElementName=Root}"
                            Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            Height="20">
                        </ComboBox>
                        <Button Style="{StaticResource StaticButton}" Grid.Column="3" Margin="5,0,0,0" Command="{Binding RemoveCommand}" CommandParameter="{Binding .}">
                            <fa:FontAwesome Icon="Close"></fa:FontAwesome>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button HorizontalAlignment="Left" Click="AddButton_OnClick" Content="{lex:Loc Filter.MultiValueFilter.AddFilter}"></Button>
    </StackPanel>
</UserControl>
